# ============================================================================
#  Variables d'environnement — CONGLOMERAT
#  Copie ce fichier en .env.local pour le développement local.
#  Sur Vercel : Project → Settings → Environment Variables.
# ============================================================================

# --- Base de données (obligatoire en production) ---------------------------
# Laisser vide pour la démonstration locale. En production : chaîne PostgreSQL complète.
# Neon : URL « pooled ». Render Postgres : URL interne depuis Render, externe depuis Vercel.
# Conserver les paramètres TLS du fournisseur. POSTGRES_URL est accepté en repli.
DATABASE_URL=

# --- Session ---------------------------------------------------------------
# Secret de signature des cookies de session (32+ caractères aléatoires).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Administrateur --------------------------------------------------------
# Prioritaires sur credentials.js si définis.
ADMIN_EMAIL=admin@conglomerat.cm
ADMIN_PASSWORD=

# --- Site ------------------------------------------------------------------
# URL publique, utilisée par le plan du site et les métadonnées de partage.
SITE_URL=https://conglomerat.vercel.app

# --- Paiement (démo uniquement) --------------------------------------------
# Le module de paiement est un simulateur : aucune clé requise, aucun débit.
# Ces variables n'existent que pour rappeler qu'un vrai branchement Mobile Money
# exige un contrat opérateur et un webhook signé côté serveur.
PAYMENT_MODE=demo

# --- Carte -----------------------------------------------------------------
# Style vectoriel OpenFreeMap. Peut aussi être changé depuis l'admin.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
